# Copy to .env, then replace CHANGE_ME values. Keep .env private.
POSTGRES_DB=north
POSTGRES_USER=north
# Generate with: openssl rand -hex 24. Use same value in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://north:CHANGE_ME@postgres:5432/north
# Generate with: openssl rand -hex 32 (64 hexadecimal characters).
NORTH_OTP_HMAC_KEY=CHANGE_ME
# Required by image-only Compose; the local build overlay overrides these refs.
# Pin qualified image digests for deployment.
NORTH_SERVER_IMAGE=ghcr.io/r05323028/north-server:v0.1.0
NORTH_WEB_IMAGE=ghcr.io/r05323028/north-web:v0.1.0

# Optional host-port overrides (defaults: 8080 and 3000).
# NORTH_SERVER_HOST_PORT=8080
# NORTH_WEB_HOST_PORT=3000
